# Optional. Without a key the coach uses a rule-based offline reply.
# The server uses OpenRouter if OPENROUTER_API_KEY is set, otherwise Groq if GROQ_API_KEY is set.
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
