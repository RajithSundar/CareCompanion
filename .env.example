# The coach's language model. The first complete block wins: Azure OpenAI, then OpenRouter, then Groq.
# With none set, the coach uses rule-based replies and rule-based memory extraction.

# Azure OpenAI (Azure AI Foundry): the target platform for this project.
# Endpoint and key: Azure portal > your Azure OpenAI resource > Keys and Endpoint.
# Deployment: the name you gave the model deployment (for example gpt-4o-mini).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional limits on LLM use
# CC_COACH_PER_10MIN=15
# CC_COACH_PER_DAY=60
# CC_LLM_GLOBAL_PER_DAY=500

# Sign-in (optional). Without CC_JWT_SECRET a random key is generated into data/.jwt_secret.
# CC_JWT_SECRET=
# CC_DEMO_PASSWORD=demo1234
# CC_SHOW_DEMO_PASSWORD=1
# CC_TOKEN_TTL_HOURS=8
# CC_LOGINS_PER_5MIN=10
